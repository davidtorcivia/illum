# Cloudflare's headers for the site's static files (deploy/dist/_headers; not itself served). Everything else keeps the
# default, revalidated on every use: the kit's modules and faces keep their names when they change.
# The baked ornament's bands are named by their bytes (tools/bake.mjs), so a reader's browser keeps them without asking again.
/kit/bake/*
  Cache-Control: public, max-age=31536000, immutable
